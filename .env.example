# Copy to .env and change the passwords:  cp .env.example .env
# .env is gitignored. scripts/start.sh turns it into a Kubernetes Secret.
# Passwords are only applied when the database is first created (or after scripts/reset.sh).

# SYS / SYSTEM admin password
ORACLE_PASSWORD=ChangeMe_Admin1

# Password for the SALES schema (the app user you connect with from DBeaver)
APP_USER_PASSWORD=ChangeMe_Sales1

# Password for C##DBZUSER, the LogMiner user Debezium connects with
DBZ_PASSWORD=ChangeMe_Dbz1
